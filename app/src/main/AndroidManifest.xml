<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/transceb_logo_clear"
        android:label="@string/app_name"
        android:roundIcon="@drawable/transceb_logo_clear"
        android:supportsRtl="true"
        android:theme="@style/Theme.TransCeb">

        <activity
            android:name=".LoginActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.TransCeb">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".RegisterActivity"
            android:exported="false"
            android:label="Sign Up - TransCeb"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.TransCeb" />

        <activity
            android:name=".ForgotPasswordActivity"
            android:exported="false"
            android:label="Forgot Password - TransCeb"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.TransCeb" />

        <activity
            android:name=".OtpVerificationActivity"
            android:exported="false"
            android:label="OTP Verification - TransCeb"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.TransCeb" />

        <activity
            android:name=".HomeActivity"
            android:exported="false"
            android:label="TransCeb Home"
            android:theme="@style/Theme.TransCeb" />

        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:theme="@style/Theme.TransCeb" />
    </application>

</manifest>
